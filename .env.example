# Optional TURN configuration for reliable connectivity across restrictive networks.
# Keep these values in deployment environment settings, not in committed secrets.
# Multiple URLs may be comma-separated.
NEXT_PUBLIC_TURN_URLS=turn:your-turn-server.example.com:3478?transport=udp,turn:your-turn-server.example.com:3478?transport=tcp
NEXT_PUBLIC_TURN_USERNAME=
NEXT_PUBLIC_TURN_CREDENTIAL=
